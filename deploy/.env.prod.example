# Production environment for docker-compose.prod.yml.
# Copy to .env.prod (gitignored) and fill in every REQUIRED value.
# NOTE: compose env_file does NOT interpolate between variables — write full
# literal values (e.g. the password appears both alone and inside DATABASE_URL).

# ── Database ─────────────────────────────────────
# REQUIRED: password for the postgres container.
POSTGRES_PASSWORD=change-me
# REQUIRED: must match POSTGRES_PASSWORD above. Host is the compose service name.
DATABASE_URL=postgres://postgres:change-me@postgres:5432/macp_control_plane
DB_POOL_MAX=20

# ── HTTP ─────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
# REQUIRED: comma-separated API keys — the app fails to start in production
# without at least one.
AUTH_API_KEYS=
CORS_ORIGIN=https://your-ui-host.example.com

# ── Runtime (gRPC) ───────────────────────────────
RUNTIME_KIND=rust
RUNTIME_ADDRESS=your-runtime-host:50051
# TLS is required in production (RUNTIME_ALLOW_INSECURE=true is rejected there).
RUNTIME_TLS=true
# Static observer Bearer token (or configure JWT-mint mode below).
RUNTIME_BEARER_TOKEN=

# ── Runtime auth (JWT-mint mode, preferred) ──────
# When set, a short-lived observer JWT is minted instead of the static token.
MACP_AUTH_SERVICE_URL=
MACP_AUTH_TOKEN_SENDER=macp-control-plane

# ── Stream hub ───────────────────────────────────
# memory is fine for a single instance; use redis + REDIS_URL when scaling out.
STREAM_HUB_STRATEGY=memory
REDIS_URL=

# ── Data retention ───────────────────────────────
DATA_RETENTION_ENABLED=false
DATA_RETENTION_TTL_DAYS=30

# ── Observability ────────────────────────────────
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
