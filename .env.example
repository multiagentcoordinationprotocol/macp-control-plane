# ── HTTP ──────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ── Authentication ────────────────────────────────
# Comma-separated list of valid API keys. Empty = auth disabled (dev mode).
# REQUIRED in production — app will fail to start without this.
AUTH_API_KEYS=

# ── Database ─────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/macp_control_plane
DB_POOL_MAX=20                    # Min 2 in production
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

# ── Runtime (gRPC) — observer-only control-plane identity ────
# The control-plane has ONE least-privilege runtime identity. Agents authenticate
# to the runtime directly (RFC-MACP-0004 §4); the control-plane never calls Send.
# Its token in MACP_AUTH_TOKENS_JSON must have `can_start_sessions: false`.
RUNTIME_KIND=rust
RUNTIME_ADDRESS=127.0.0.1:50051
RUNTIME_TLS=false                 # Must be true in production (or set RUNTIME_ALLOW_INSECURE=true)
RUNTIME_ALLOW_INSECURE=true       # Defaults to false in production
RUNTIME_BEARER_TOKEN=             # Control-plane's own observer Bearer token
# DEPRECATED (runtime v0.5.0): the x-macp-agent-id dev header was removed from the
# runtime. This flag now gates a dev-BEARER fallback — with no static/JWT token
# the resolver sends `Authorization: Bearer ${RUNTIME_DEV_AGENT_ID}`, which a
# dev-mode runtime (MACP_ALLOW_INSECURE=1, no auth configured) accepts as the
# sender identity. Defaults to false in production and is rejected there.
RUNTIME_USE_DEV_HEADER=true       # Dev-only; deprecated (see note above)
RUNTIME_DEV_AGENT_ID=macp-control-plane  # Also the dev-bearer token value
RUNTIME_REQUEST_TIMEOUT_MS=30000  # Warn if < 5000

# ── listSessions() pagination (Phase 2, runtime v0.7.0 absorption) ──
# Page size is deliberately 200, NOT the runtime's max of 1000: the gRPC
# client has no channel options, so grpc-js's default 4 MB
# max_receive_message_length applies, and a 1000-item page of large sessions
# (up to 1000 participants each) can approach that limit and fail with
# RESOURCE_EXHAUSTED. Must be a positive integer (validated at startup).
RUNTIME_LIST_SESSIONS_PAGE_SIZE=200
# Guards a server that never clears next_page_token; exhausting it returns a
# truthful complete:false with the collected prefix instead of truncating
# silently. Must be a positive integer (validated at startup).
RUNTIME_LIST_SESSIONS_MAX_PAGES=200
# Bounds the WHOLE drain (not per-page). On expiry, returns complete:false.
# Must be a positive integer (validated at startup).
RUNTIME_LIST_SESSIONS_TIMEOUT_MS=60000

# ── Runtime auth (JWT-mint mode, preferred) ──────
# When MACP_AUTH_SERVICE_URL is set, RuntimeCredentialResolverService mints a
# short-lived RS256 JWT for the control-plane (scopes: is_observer=true,
# can_start_sessions=false) instead of using the static RUNTIME_BEARER_TOKEN.
# Tokens are cached until TTL minus a 30s refresh buffer and 10s clock-skew;
# concurrent refreshes are deduped. On mint failure the resolver falls back to
# the static Bearer so a brief auth-service outage doesn't fail every call.
MACP_AUTH_SERVICE_URL=                         # e.g. https://auth.internal — leave blank to disable
MACP_AUTH_SERVICE_TIMEOUT_MS=5000
MACP_AUTH_TOKEN_TTL_SECONDS=3600
MACP_AUTH_TOKEN_SENDER=macp-control-plane
# Opt-in: mint the runtime JWT with `can_manage_mode_registry` so the admin UI's
# policy/mode register + unregister calls are authorized by the runtime. Stays
# false by default to keep the control-plane strictly read-only (observer).
MACP_AUTH_TOKEN_CAN_MANAGE_REGISTRY=false

# ── Session polling (observer mode) ──────────────
# Control-plane polls GetSession(sessionId) until the initiator agent opens
# the session, then subscribes read-only via StreamSession.
SESSION_POLL_BASE_MS=100
SESSION_POLL_MAX_MS=1000
SESSION_POLL_TIMEOUT_MS=60000

# ── UI-initiated cancel (Option A) ────────────────
# HTTP timeout for proxying a UI cancel to the initiator agent's cancelCallback.
CANCEL_CALLBACK_TIMEOUT_MS=5000

# ── Session Discovery ─────────────────────────────
# When enabled, subscribes to WatchSessions on the runtime and auto-creates
# run records for sessions started by external launchers (not via POST /runs).
SESSION_DISCOVERY_ENABLED=true

# ── Circuit Breaker ──────────────────────────────
RUNTIME_CIRCUIT_BREAKER_THRESHOLD=5
RUNTIME_CIRCUIT_BREAKER_RESET_MS=30000

# ── Stream Consumer ─────────────────────────────
STREAM_IDLE_TIMEOUT_MS=120000
STREAM_MAX_RETRIES=5
STREAM_BACKOFF_BASE_MS=250
STREAM_BACKOFF_MAX_MS=30000
STREAM_SSE_HEARTBEAT_MS=15000
# On a per-session StreamSession error, resubscribe from the persisted envelope
# ordinal (runtime v0.5.0 stable, exclusive after_sequence) instead of degrading
# to a GetSession poll loop. Set false to restore the legacy poll-degrade path.
STREAM_RESUME_ENABLED=true

# ── Stream Hub ───────────────────────────────────
# Strategy: memory (default, single-instance) | redis (multi-instance)
# Production warning if memory strategy is used.
STREAM_HUB_STRATEGY=memory
REDIS_URL=                        # Required when STREAM_HUB_STRATEGY=redis

# ── Replay ───────────────────────────────────────
REPLAY_MAX_DELAY_MS=2000
REPLAY_BATCH_SIZE=500

# ── Run Recovery ────────────────────────────────
RUN_RECOVERY_ENABLED=true

# ── Data Retention ───────────────────────────────
# Periodically purges terminal runs, audit logs, and webhook deliveries older than TTL.
# Uses advisory locks for multi-instance safety.
DATA_RETENTION_ENABLED=false
DATA_RETENTION_TTL_DAYS=30        # Min 1 when enabled
DATA_RETENTION_INTERVAL_HOURS=24
DATA_RETENTION_BATCH_SIZE=500

# ── Logging ──────────────────────────────────────
LOG_LEVEL=info

# ── OpenTelemetry ────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=macp-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Integration Tests ────────────────────────────
# Runtime mode for integration tests: mock | docker | remote
INTEGRATION_RUNTIME=mock
